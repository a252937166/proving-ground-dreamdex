# Optional overrides. Copy to .env to use them; every value has a working default.
# This prototype is read-only: it never reads a private key and never signs anything.

# Somnia Hideki ("Tokyo") testnet, chain 50383. Defaults come from
# @somnia-chain/markets-sdk/chains (hidekiTestnet).
# HIDEKI_RPC_URL=https://api.hideki2.infra.testnet.somnia.network
# HIDEKI_WS_URL=wss://api.hideki2.infra.testnet.somnia.network/ws

# dreamDEX (Somnia Markets) indexer for Hideki.
# DREAMDEX_INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql

# Order book levels read per side (1..100).
# BOOK_DEPTH=20

# Port for `npm run serve` (binds to 127.0.0.1 only).
# PORT=8787
