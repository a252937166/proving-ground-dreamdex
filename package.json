{
  "name": "proving-ground-dreamdex",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only dreamDEX BTC-PERP integration prototype for Proving Ground (Somnia Hideki / Tokyo testnet, chain 50383).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a252937166/proving-ground-dreamdex.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "snapshot": "tsx src/cli.ts snapshot",
    "precheck": "tsx src/cli.ts precheck",
    "serve": "tsx src/server.ts",
    "test": "tsx --test --test-reporter=spec test/unit/*.test.ts",
    "test:live": "tsx --test --test-reporter=spec test/live/*.test.ts",
    "typecheck": "tsc --noEmit",
    "mr": "tsx src/margin-rescue/cli.ts",
    "mr:fork-e2e": "tsx src/margin-rescue/forkE2e.ts",
    "rpc-shim": "node tools/rpc-shim.mjs",
    "test:contracts": "cd contracts && forge test --match-path 'test/unit/*'",
    "test:fork": "cd contracts && forge test --match-path 'test/fork/*'",
    "mr:live": "tsx src/margin-rescue/liveRun.ts",
    "mr:verify-run": "tsx tools/verify-live-run.ts",
    "mr:publish-run": "tsx tools/publish-live-run.ts",
    "mr:fork-rehearsal": "tsx src/margin-rescue/forkRehearsal.ts",
    "build:site": "tsx tools/build-site.ts"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "0.32.1",
    "tsx": "4.23.15",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
